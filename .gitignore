# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.local
.env.production
.env.development
server/.env
hf_final_deploy/.env
hf_deploy/.env
# Allow example/template files to be committed
!.env.example
!.env.local.example
!hf_final_deploy/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local app data
.local/
brain/
artifacts/

# python
__pycache__/
*.py[cod]
*$py.class
server/__pycache__/
server/app/__pycache__/
server/app/services/__pycache__/
.env
.venv
venv/
ENV/
hf_final_deploy/__pycache__/
hf_final_deploy/app/__pycache__/
hf_final_deploy/app/services/__pycache__/
